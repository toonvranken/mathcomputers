# Kopieer naar .env op de server en vul in.

# SQLite (licht genoeg voor een kleine VPS)
DATABASE_URL="file:./data/prod.db"

# Genereer met: openssl rand -base64 32
AUTH_SECRET="VERVANG-DIT-DOOR-EEN-LANGE-RANDOM-STRING"
AUTH_URL="https://mathcomputers.be"

NODE_ENV="production"
PORT=3000

# ─── E-mail bij nieuw contactbericht ─────────────────────────
# Zonder deze blok blijft alles werken, maar krijg je alleen
# berichten in /admin/messages (geen melding in je inbox).
#
# Voorbeeld: mailbox bij je host of Microsoft 365 / Google Workspace
SMTP_HOST="smtp.jouw-provider.be"
SMTP_PORT="587"
SMTP_USER="info@mathcomputers.be"
SMTP_PASS="jouw-app-wachtwoord-of-mailbox-wachtwoord"
SMTP_FROM="info@mathcomputers.be"
# Waar de melding naartoe moet (mag je privémail zijn):
CONTACT_NOTIFY_TO="info@mathcomputers.be"
